# 通用
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# 数据库（开发默认 SQLite；生产使用 PostgreSQL，见 README）
DATABASE_URL="file:./dev.db"

# 鉴权（JWT_SECRET 至少 32 个字符）
JWT_SECRET=dev-only-secret-please-change-me-0123456789
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# 上传
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
MAX_PHOTOS_PER_OBSERVATION=9
STRIP_GPS_DEFAULT=true

# 对象存储（可选，本构建仅内置本地磁盘存储）
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# 观察任务：扫描待办、提醒与逾期的周期（分钟），按任务各自时区计算
TASK_SCAN_INTERVAL_MIN=60

# 前端（构建期）
VITE_API_BASE_URL=/api/v1
