// 该文件由 scripts/sync-postgres-schema.mjs 从 schema.prisma 生成，请勿手工编辑。
// 生成命令：pnpm --filter @nature/api db:sync-schema
// 自然观察时间线 · 数据模型
// 开发与测试使用 SQLite；生产可切换到 PostgreSQL（见 schema.postgres.prisma）。
// 枚举字段统一使用 String，避免两种数据库对 enum 的支持差异。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String
  role         String   @default("USER")
  timezone     String   @default("Asia/Shanghai")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens RefreshToken[]
  sites         Site[]
  species       Species[]
  observations  Observation[]
  tags          Tag[]
  shareLinks    ShareLink[]
  taskRules     ObservationTaskRule[]
  tasks         ObservationTask[]
  taskEvents    ObservationTaskEvent[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Site {
  id          String    @id @default(cuid())
  ownerId     String
  name        String
  latitude    Float?
  longitude   Float?
  elevationM  Int?
  habitat     String?
  description String?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  owner        User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  observations Observation[]
  shareLinks   ShareLink[]
  taskRules    ObservationTaskRule[]

  @@unique([ownerId, name])
  @@index([ownerId, archivedAt])
}

model Species {
  id             String    @id @default(cuid())
  ownerId        String?
  category       String
  commonName     String
  scientificName String?
  family         String?
  description    String?
  isPreset       Boolean   @default(false)
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  owner        User?                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  phenophases  Phenophase[]
  observations Observation[]
  taskRules    ObservationTaskRule[]

  @@index([ownerId, category, commonName])
  @@index([category, commonName])
  @@index([isPreset])
}

model Phenophase {
  id         String  @id @default(cuid())
  speciesId  String
  name       String
  code       String?
  orderIndex Int     @default(0)
  color      String  @default("#3F6F52")
  isDefault  Boolean @default(false)

  species      Species               @relation(fields: [speciesId], references: [id], onDelete: Cascade)
  observations Observation[]
  taskRules    ObservationTaskRule[]

  @@unique([speciesId, name])
  @@index([speciesId, orderIndex])
}

model Observation {
  id              String    @id @default(cuid())
  ownerId         String
  siteId          String
  speciesId       String?
  phenophaseId    String?
  kind            String
  status          String    @default("PUBLISHED")
  observationDate String
  observedAt      DateTime?
  title           String?
  notes           String?
  temperatureC    Float?
  precipitationMm Float?
  windLevel       Int?
  humidityPct     Int?
  anomalyType     String?
  anomalySeverity String?
  impactNotes     String?
  source          String    @default("MANUAL")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  owner      User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  site       Site               @relation(fields: [siteId], references: [id], onDelete: Restrict)
  species    Species?           @relation(fields: [speciesId], references: [id], onDelete: SetNull)
  phenophase Phenophase?        @relation(fields: [phenophaseId], references: [id], onDelete: SetNull)
  photos     ObservationPhoto[]
  tags       ObservationTag[]
  tasks      ObservationTask[]

  @@index([ownerId, status, observationDate])
  @@index([siteId, speciesId, phenophaseId, observationDate])
  @@index([ownerId, kind, observationDate])
  @@index([siteId, observationDate])
}

model ObservationPhoto {
  id            String    @id @default(cuid())
  observationId String
  storageKey    String    @unique
  thumbKey      String
  displayKey    String
  originalName  String
  mimeType      String
  width         Int
  height        Int
  bytes         Int
  takenAt       DateTime?
  gpsStripped   Boolean   @default(true)
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())

  observation Observation @relation(fields: [observationId], references: [id], onDelete: Cascade)

  @@index([observationId, sortOrder])
}

model Tag {
  id        String   @id @default(cuid())
  ownerId   String
  name      String
  color     String   @default("#B0793A")
  createdAt DateTime @default(now())

  owner        User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  observations ObservationTag[]

  @@unique([ownerId, name])
}

model ObservationTag {
  observationId String
  tagId         String

  observation Observation @relation(fields: [observationId], references: [id], onDelete: Cascade)
  tag         Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([observationId, tagId])
  @@index([tagId])
}

model ShareLink {
  id        String    @id @default(cuid())
  token     String    @unique
  siteId    String
  ownerId   String
  scope     String    @default("TIMELINE")
  expiresAt DateTime
  revokedAt DateTime?
  viewCount Int       @default(0)
  createdAt DateTime  @default(now())

  site  Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([siteId, revokedAt])
}

// ── 观察任务（待办）─────────────────────────────────────────────────────────
// 规则按物候窗口（每年一段 MM-DD ~ MM-DD，允许跨年）描述"何时该去观察什么"；
// 扫描器为每个处于活跃期的窗口年生成恰好一条 ObservationTask，事件表只追加。

model ObservationTaskRule {
  id               String   @id @default(cuid())
  ownerId          String
  siteId           String
  speciesId        String?
  phenophaseId     String?
  name             String
  kind             String
  windowStartMd    String
  windowEndMd      String
  dueOffsetDays    Int      @default(0)
  remindBeforeDays Int      @default(3)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  owner      User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  site       Site              @relation(fields: [siteId], references: [id], onDelete: Restrict)
  species    Species?          @relation(fields: [speciesId], references: [id], onDelete: SetNull)
  phenophase Phenophase?       @relation(fields: [phenophaseId], references: [id], onDelete: SetNull)
  tasks      ObservationTask[]

  @@index([ownerId, active])
  @@index([siteId])
}

model ObservationTask {
  id             String    @id @default(cuid())
  ownerId        String
  ruleId         String
  occurrenceKey  String
  windowStart    String
  windowEnd      String
  dueDate        String
  status         String    @default("OPEN")
  reminderSentAt DateTime?
  completedAt    DateTime?
  completedDate  String?
  observationId  String?
  closedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  owner       User                   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  rule        ObservationTaskRule    @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  observation Observation?           @relation(fields: [observationId], references: [id], onDelete: SetNull)
  events      ObservationTaskEvent[]

  // 幂等核心：同一规则、同一窗口年只有一条待办，重复扫描不会产生第二条
  @@unique([ownerId, ruleId, occurrenceKey])
  @@index([ownerId, status, dueDate])
  @@index([status, reminderSentAt, dueDate])
  @@index([ruleId])
}

// 只追加（append-only）历史：任何状态流转都落一条事件，永不更新、永不删除。
model ObservationTaskEvent {
  id         String   @id @default(cuid())
  taskId     String
  ownerId    String
  type       String
  payload    String
  occurredAt DateTime @default(now())

  task  ObservationTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  owner User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  // 同一任务每种事件至多一条：提醒/完成/补录/关闭绝不重复留痕
  @@unique([taskId, type])
  @@index([taskId, occurredAt])
  @@index([ownerId, occurredAt])
}
