// 该文件由 scripts/sync-postgres-schema.mjs 从 schema.prisma 生成，请勿手工编辑。
// 生成命令：pnpm --filter @nature/api db:sync-schema
// 自然观察时间线 · 数据模型
// 开发与测试使用 SQLite；生产可切换到 PostgreSQL（见 schema.postgres.prisma）。
// 枚举字段统一使用 String，避免两种数据库对 enum 的支持差异。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String
  role         String   @default("USER")
  timezone     String   @default("Asia/Shanghai")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens    RefreshToken[]
  sites            Site[]
  species          Species[]
  observations     Observation[]
  tags             Tag[]
  shareLinks       ShareLink[]
  observationTasks ObservationTask[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Site {
  id          String    @id @default(cuid())
  ownerId     String
  name        String
  latitude    Float?
  longitude   Float?
  elevationM  Int?
  habitat     String?
  description String?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  observations Observation[]
  shareLinks   ShareLink[]
  observationTasks ObservationTask[]

  @@unique([ownerId, name])
  @@index([ownerId, archivedAt])
}

model Species {
  id             String    @id @default(cuid())
  ownerId        String?
  category       String
  commonName     String
  scientificName String?
  family         String?
  description    String?
  isPreset       Boolean   @default(false)
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  owner        User?         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  phenophases  Phenophase[]
  observations Observation[]
  observationTasks ObservationTask[]

  @@index([ownerId, category, commonName])
  @@index([category, commonName])
  @@index([isPreset])
}

model Phenophase {
  id         String  @id @default(cuid())
  speciesId  String
  name       String
  code       String?
  orderIndex Int     @default(0)
  color      String  @default("#3F6F52")
  isDefault  Boolean @default(false)

  species      Species       @relation(fields: [speciesId], references: [id], onDelete: Cascade)
  observations Observation[]
  observationTasks ObservationTask[]

  @@unique([speciesId, name])
  @@index([speciesId, orderIndex])
}

model Observation {
  id              String    @id @default(cuid())
  ownerId         String
  siteId          String
  speciesId       String?
  phenophaseId    String?
  kind            String
  status          String    @default("PUBLISHED")
  observationDate String
  observedAt      DateTime?
  title           String?
  notes           String?
  temperatureC    Float?
  precipitationMm Float?
  windLevel       Int?
  humidityPct     Int?
  anomalyType     String?
  anomalySeverity String?
  impactNotes     String?
  source          String    @default("MANUAL")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  owner       User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  site        Site              @relation(fields: [siteId], references: [id], onDelete: Restrict)
  species     Species?          @relation(fields: [speciesId], references: [id], onDelete: SetNull)
  phenophase  Phenophase?       @relation(fields: [phenophaseId], references: [id], onDelete: SetNull)
  photos      ObservationPhoto[]
  tags        ObservationTag[]
  taskCompletions ObservationTaskInstance[]

  @@index([ownerId, status, observationDate])
  @@index([siteId, speciesId, phenophaseId, observationDate])
  @@index([ownerId, kind, observationDate])
  @@index([siteId, observationDate])
}

model ObservationPhoto {
  id            String    @id @default(cuid())
  observationId String
  storageKey    String    @unique
  thumbKey      String
  displayKey    String
  originalName  String
  mimeType      String
  width         Int
  height        Int
  bytes         Int
  takenAt       DateTime?
  gpsStripped   Boolean   @default(true)
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())

  observation Observation @relation(fields: [observationId], references: [id], onDelete: Cascade)

  @@index([observationId, sortOrder])
}

model Tag {
  id        String   @id @default(cuid())
  ownerId   String
  name      String
  color     String   @default("#B0793A")
  createdAt DateTime @default(now())

  owner        User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  observations ObservationTag[]

  @@unique([ownerId, name])
}

model ObservationTag {
  observationId String
  tagId         String

  observation Observation @relation(fields: [observationId], references: [id], onDelete: Cascade)
  tag         Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([observationId, tagId])
  @@index([tagId])
}

model ShareLink {
  id        String    @id @default(cuid())
  token     String    @unique
  siteId    String
  ownerId   String
  scope     String    @default("TIMELINE")
  expiresAt DateTime
  revokedAt DateTime?
  viewCount Int       @default(0)
  createdAt DateTime  @default(now())

  site  Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([siteId, revokedAt])
}

// 观察任务：按物候窗口（每年的 MM-DD ~ MM-DD）在指定时区下逐年生成待办实例。
model ObservationTask {
  id            String    @id @default(cuid())
  ownerId       String
  title         String
  siteId        String
  speciesId     String?
  phenophaseId  String?
  kind          String
  windowStart   String // 窗口起始日，MM-DD（当地日历）
  windowEnd     String // 窗口结束日，MM-DD（不允许跨年折返，start <= end）
  timezone      String    @default("Asia/Shanghai")
  reminderDays  Int       @default(0) // 窗口开始前多少天提醒，>= 0
  note          String?
  status        String    @default("ACTIVE") // ACTIVE / CLOSED
  closedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  owner     User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  site      Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  species   Species?       @relation(fields: [speciesId], references: [id], onDelete: SetNull)
  phenophase Phenophase?   @relation(fields: [phenophaseId], references: [id], onDelete: SetNull)
  instances ObservationTaskInstance[]
  events    ObservationTaskEvent[]

  @@unique([ownerId, title])
  @@index([ownerId, status])
  @@index([siteId])
}

// 任务实例：一个任务在某一年的待办。(taskId, year) 唯一，保证重复扫描不会产生两条。
model ObservationTaskInstance {
  id                String    @id @default(cuid())
  taskId            String
  year              Int
  windowStartDate   String // 解析后的当地日历日 YYYY-MM-DD
  windowEndDate     String
  reminderDate      String? // 窗口开始前 reminderDays 天
  status            String    @default("PENDING") // PENDING / COMPLETED / BACKFILLED / SKIPPED
  observationId     String?
  completedAt       DateTime?
  completedDate     String? // 实际观察日（当地日历日），用于区分按时完成与逾期补录
  completedDaysLate Int? // 相对 windowEndDate 的逾期天数，0 表示窗口内完成
  completionNote    String?
  remindedAt        DateTime?
  overdueMarkedAt   DateTime?
  reopenedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  task        ObservationTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  observation Observation?    @relation(fields: [observationId], references: [id], onDelete: SetNull)

  @@unique([taskId, year])
  @@index([status, year])
  @@index([observationId])
}

// 任务事件流：创建/更新/提醒/逾期/完成/补录/关闭/重开/跳过，只追加不改写。
model ObservationTaskEvent {
  id        String   @id @default(cuid())
  taskId    String
  instanceId String?
  type      String // CREATED/UPDATED/REMINDER_SENT/OVERDUE/COMPLETED/BACKFILLED/CLOSED/REOPENED/SKIPPED
  detail    String? // JSON 字符串，保存动作上下文
  createdAt DateTime @default(now())

  task ObservationTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@index([instanceId])
}
